{
  "_comment": "Template: `make init` copies it to config/sandbox.json (git-ignored). Sandbox defaults: everything is destroyable. Fields: docs/deployment-guide.md.",
  "stackName": "proto-nl-sandbox",
  "resourcePrefix": "proto-nl",
  "removalPolicy": "destroy",
  "modelId": "us.amazon.nova-lite-v1:0",
  "modelMaxTokens": 1024,
