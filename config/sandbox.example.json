    "rateLimit": 20,
    "burstLimit": 40
  },
  "natGateways": 1,
  "enableWaf": true,
  "tags": {
    "Project": "proto-nl",
    "Purpose": "prototype",
    "Teardown": "after-test"
  },
  "gatewayPolicyMode": "ENFORCE",
  "sessionIdleSeconds": 900,
  "runtimeMaxLifetimeSeconds": 28800
}
